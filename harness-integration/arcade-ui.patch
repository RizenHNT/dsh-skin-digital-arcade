+/** Inert pixel curtain. The caller keys only this decoration on navigation. */
+export function ArcadeTransition({ label }: { label: string }) {
+  return (
+    <div data-arcade-transition aria-hidden="true">
+      <i /><i /><i /><i /><i /><i />
+      <span data-arcade-transition-label>{label}</span>
+    </div>
+  )
+}
diff --git a/packages/client/ui-primitives/src/DetailOverlayRoot.ts b/packages/client/ui-primitives/src/DetailOverlayRoot.ts
new file mode 100644
--- /dev/null
+++ b/packages/client/ui-primitives/src/DetailOverlayRoot.ts
@@ -0,0 +1,74 @@
+import { createPortal } from 'react-dom'
+import { useEffect, useState, type ReactNode, type ReactPortal } from 'react'
+
+const DETAIL_OVERLAY_ROOT_SELECTOR = '[data-dsh-detail-overlay-root="true"]'
+const DETAIL_OVERLAY_ROOT_META = Symbol.for('dsh.detail-overlay-root.meta')
+
+interface DetailOverlayRootMeta {
+  leases: number
+}
+
+type DetailOverlayRootElement = HTMLDivElement & {
+  [DETAIL_OVERLAY_ROOT_META]?: DetailOverlayRootMeta
+}
+
+/** Find or create the body child shared by floating detail panels. */
+function getDetailOverlayRoot(): HTMLDivElement | null {
+  if (typeof document === 'undefined' || document.body === null) return null
+  const existing = document.body.querySelector<HTMLDivElement>(DETAIL_OVERLAY_ROOT_SELECTOR)
+  if (existing !== null) return existing
+  const root = document.createElement('div')
+  root.setAttribute('data-dsh-detail-overlay-root', 'true')
+  document.body.append(root)
+  return root
+}
+
+/** Reserve one owner lease on the shared detail root. */
+function acquireDetailOverlayRoot(): HTMLDivElement | null {
+  const root = getDetailOverlayRoot()
+  if (root === null) return null
+  const ownedRoot = root as DetailOverlayRootElement
+  const metadata = ownedRoot[DETAIL_OVERLAY_ROOT_META] ?? { leases: 0 }
+  metadata.leases += 1
+  ownedRoot[DETAIL_OVERLAY_ROOT_META] = metadata
+  return root
+}
+
+/** Release one owner lease and remove only an empty, unleased root. */
+function releaseDetailOverlayRoot(root: HTMLDivElement): void {
+  const ownedRoot = root as DetailOverlayRootElement
+  const metadata = ownedRoot[DETAIL_OVERLAY_ROOT_META]
+  if (metadata === undefined) return
+  metadata.leases = Math.max(0, metadata.leases - 1)
+  if (metadata.leases !== 0) return
+  const removeIfEmpty = (): void => {
+    const current = ownedRoot[DETAIL_OVERLAY_ROOT_META]
+    if (current === undefined || current.leases !== 0 || root.childElementCount !== 0) return
+    root.remove()
+    delete ownedRoot[DETAIL_OVERLAY_ROOT_META]
+  }
+  if (root.childElementCount === 0) removeIfEmpty()
+  else queueMicrotask(removeIfEmpty)
+}
+
+/**
+ * Lease the shared body portal target while a detail panel is open.
+ * @param open - whether the calling panel is rendered.
+ * @returns the connected body target, or null while closed or unavailable.
+ */
+export function useDetailOverlayRoot(open: boolean): HTMLDivElement | null {
+  const [root, setRoot] = useState<HTMLDivElement | null>(null)
+  useEffect(() => {
+    if (!open) return
+    const next = acquireDetailOverlayRoot()
+    if (next === null) return
+    setRoot(next)
+    return () => { releaseDetailOverlayRoot(next) }
+  }, [open])
+  return open && root?.isConnected === true ? root : null
+}
+
+/** Render detail content through an already leased body portal target. */
+export function createDetailPortal(children: ReactNode, root: HTMLDivElement | null): ReactPortal | null {
+  return root === null ? null : createPortal(children, root)
+}
