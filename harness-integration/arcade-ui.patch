diff --git a/packages/client/ui-conversation/src/client/skeleton/ArcadeParticles.tsx b/packages/client/ui-conversation/src/client/skeleton/ArcadeParticles.tsx
new file mode 100644
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/skeleton/ArcadeParticles.tsx
@@ -0,0 +1,90 @@
+import { useEffect, useRef } from 'react'
+import { createPortal } from 'react-dom'
+
+interface ParticleOptions {
+  particleCount: number
+  origin: { x: number; y: number }
+  colors: string[]
+  shapes: string[]
+  flat: boolean
+  ticks: number
+  scalar: number
+  spread: number
+  startVelocity: number
+  gravity: number
+  decay: number
+  drift: number
+  angle: number
+}
+
+type Emitter = ((options: ParticleOptions) => Promise<void> | null) & { reset(): void }
+interface ParticleModule {
+  default: { create(canvas: HTMLCanvasElement, options: { resize: boolean; useWorker: boolean; disableForReducedMotion: boolean }): Emitter }
+}
+
+/** Local decorative particles: consumes pointer coordinates, never session data. */
+export function ArcadeParticles() {
+  const canvasRef = useRef<HTMLCanvasElement>(null)
+  useEffect(() => {
+    const canvas = canvasRef.current
+    if (canvas === null) return
+    const motion = window.matchMedia('(prefers-reduced-motion: reduce)')
+    const finePointer = window.matchMedia('(pointer: fine)')
+    let disposed = false
+    let emitter: Emitter | undefined
+    let lastMove = 0
+    let previousX = 0
+    let previousY = 0
+    const enabled = () => !document.hidden && !motion.matches && document.body.hasAttribute('data-dsh-arcade')
+    const emit = (x: number, y: number, burst: boolean) => {
+      if (!enabled() || emitter === undefined) return
+      const bounds = canvas.getBoundingClientRect()
+      if (bounds.width === 0 || bounds.height === 0) return
+      void emitter({
+        particleCount: burst ? 12 : 3,
+        origin: { x: (x - bounds.left) / bounds.width, y: (y - bounds.top) / bounds.height },
+        colors: ['#73e9ff', '#419aff', '#a08bff', '#d8f7ff'],
+        shapes: ['square'], flat: true, ticks: burst ? 46 : 32,
+        scalar: burst ? .7 : .45, spread: burst ? 360 : 45,
+        startVelocity: burst ? 8 : 2, gravity: .08, decay: .93,
+        drift: 0, angle: burst ? 90 : Math.atan2(y - previousY, previousX - x) * 180 / Math.PI,
+      })
+    }
+    const onMove = (event: PointerEvent) => {
+      if (!finePointer.matches || event.pointerType === 'touch') return
+      const now = performance.now()
+      if (now - lastMove < 48) return
+      const distance = Math.hypot(event.clientX - previousX, event.clientY - previousY)
+      if (lastMove !== 0 && distance > 4) emit(event.clientX, event.clientY, false)
+      previousX = event.clientX
+      previousY = event.clientY
+      lastMove = now
+    }
+    const onPress = (event: PointerEvent) => {
+      if (!(event.target instanceof Element) || event.target.closest('textarea,input,[contenteditable="true"],[role="dialog"]') !== null) return
+      if (event.target.closest('button:not(:disabled),[role="button"],a') !== null) emit(event.clientX, event.clientY, true)
+    }
+    const stop = () => { if (!enabled()) emitter?.reset() }
+    // Pinned, reviewed ISC source served locally. No CDN, Worker or injected script.
+    const asset = '/assets/vendor/canvas-confetti-1.9.4/confetti.module.js'
+    void import(/* @vite-ignore */ asset).then((module: ParticleModule) => {
+      if (disposed) return
+      emitter = module.default.create(canvas, { resize: true, useWorker: false, disableForReducedMotion: true })
+      window.addEventListener('pointermove', onMove, { passive: true })
+      window.addEventListener('pointerdown', onPress, { passive: true })
+      document.addEventListener('visibilitychange', stop)
+      motion.addEventListener('change', stop)
+    }).catch(() => { /* Decoration failure leaves the workbench usable. */ })
+    return () => {
+      disposed = true
+      window.removeEventListener('pointermove', onMove)
+      window.removeEventListener('pointerdown', onPress)
+      document.removeEventListener('visibilitychange', stop)
+      motion.removeEventListener('change', stop)
+      emitter?.reset()
+    }
+  }, [])
+  return typeof document === 'undefined' ? null : createPortal(
+    <canvas ref={canvasRef} data-arcade-particles aria-hidden="true" />, document.body,
+  )
+}
