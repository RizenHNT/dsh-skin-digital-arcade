{
  "name": "dsh-skin-digital-arcade",
  "version": "0.2.3",
  "description": "Rizen Signal Console — digital arcade HUD skin for DeepSeek Harness Web GUI: neon cyan/violet/magenta palette, pixel fonts, animated HUD sprites, custom crosshair cursor, and freely placeable detail windows",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.css",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node tools/gen-skin-client.mjs",
    "build": "node build.mjs",
    "test": "node test-plugin.mjs && node test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1"
  },
  "license": "MIT"
}
