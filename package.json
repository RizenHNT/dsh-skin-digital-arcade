{
  "name": "dsh-skin-digital-arcade",
  "version": "0.3.1",
  "description": "Pixel neon arcade theme for DeepSeek Harness with opt-in appearance, whale-girl artwork, local custom display names and telemetry HUD integration",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.css",
    "assets/",
    "README.md",
    "LICENSE",
    "harness-integration/",
    "tools/apply-harness-integration.mjs"
  ],
  "scripts": {
    "gen": "node tools/gen-skin-client.mjs",
    "build": "node build.mjs",
    "test": "node test-plugin.mjs && node test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1"
  },
  "license": "MIT"
}
